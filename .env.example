# Local test credentials — copy to .env (gitignored), never commit.
# Numbered OpenCode Go (OpenAI-compatible) credentials.
# Each number registers a DISTINCT provider + credential `opencode-<n>` with its
# own key. Numbers are stable identities; gaps are allowed (e.g. 1 and 3).
OPENCODE_API_KEY_1=sk-...
OPENCODE_API_KEY_2=sk-...
# Shared defaults for every numbered OpenCode credential (optional):
DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1
DISPATCH_MODEL=deepseek-v4-flash

# Hyper provider (https://hyper.charm.land) — optional; set the key to enable.
# The key is sourced from the environment (or /etc/dispatch/env for systemd).
# Register exactly one provider + credential "hyper"; models come live from GET /models.
HYPER_API_KEY=
# Optional overrides (defaults shown):
HYPER_BASE_URL=https://hyper.charm.land/v1
HYPER_MODEL=deepseek-v4-flash