{
	"name": "dispatch",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev:api": "bun --watch packages/api/src/index.ts",
		"dev:frontend": "bun run --cwd packages/frontend dev",
