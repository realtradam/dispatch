# /etc/dispatch/env — Dispatch server configuration (systemd EnvironmentFile)
# Copy this to /etc/dispatch/env and fill in your API keys.
# Keys are managed via: sudo bin/sync-env --umans-key "sk-..." --hyper-key "sk-hyper-..." [--opencode-key "1=sk-..."]
# Or set up from scratch via: sudo bin/setup-env --umans-key "sk-..." --hyper-key "sk-hyper-..." [--opencode-key "1=sk-..."]

# ─── Ports ───────────────────────────────────────────────────────────────────
# Backend HTTP (serves API + frontend static files)
BACKEND_PORT=24991
# Surface WebSocket (frontend live updates + surfaces)
SURFACE_WS_PORT=24990

# ─── Frontend ────────────────────────────────────────────────────────────────
# Directory containing the built frontend static files (served by the backend)
DISPATCH_WEB_DIR=/usr/share/dispatch/web

# ─── Numbered OpenCode provider ───────────────────────────────────────────────
# Set keys via: sudo bin/sync-env --opencode-key "1=sk-..." [--opencode-key "3=sk-..."]
# Each number registers a DISTINCT provider + credential `opencode-<n>`.
# Numbers are stable identities; gaps allowed. The old DISPATCH_API_KEY path is
# gone and NOT supported.
# OPENCODE_API_KEY_1=sk-...
# OPENCODE_API_KEY_2=sk-...
# Shared defaults for every numbered OpenCode credential:
DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1
DISPATCH_MODEL=deepseek-v4-flash

# ─── Umans provider ──────────────────────────────────────────────────────────
# Set the key via: sudo bin/sync-env --umans-key "sk-..."
UMANS_API_KEY=sk-...

# ─── Codex / OpenAI subscription (bundled at build time) ─────────────────────
# The codex extension is compiled into the binary when ../codex is present at
# build time. Set these to configure the model and credential.
# DISPATCH_OPENAI_MODEL=codex-mini-latest
# DISPATCH_CODEX_CREDENTIAL_KEY=...
# DISPATCH_CODEX_CREDENTIAL=codex

# ─── Claude / Anthropic subscription (bundled at build time) ──────────────────
# The claude extension is compiled into the binary when ../claude is present at
# build time. Set these to configure the model and credential.
# DISPATCH_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DISPATCH_CLAUDE_CREDENTIAL_KEY=...
# DISPATCH_CLAUDE_CREDENTIAL=claude

# ─── LongCat provider (optional, set key to enable) ──────────────────────────
# LONGCAT_API_KEY=sk-...

# ─── Hyper provider (optional, set key to enable) ─────────────────────────────
# Set the key via: sudo bin/sync-env --hyper-key "sk-hyper-..."
# Remove/disable via: sudo bin/sync-env --hyper-key ""
# Optional overrides (edit manually or via env):
# HYPER_BASE_URL=https://hyper.charm.land/v1
# HYPER_MODEL=deepseek-v4-flash
# HYPER_API_KEY=sk-...

# ─── Data paths ──────────────────────────────────────────────────────────────
DISPATCH_DB=/var/lib/dispatch/dispatch.db
DISPATCH_TRACE_DB=/var/lib/dispatch/traces.db
DISPATCH_JOURNAL=/var/log/dispatch/app.ndjson