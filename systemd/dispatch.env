# /etc/dispatch/env — Dispatch server configuration (systemd EnvironmentFile)
# Copy this to /etc/dispatch/env and fill in your API keys.
# Keys are managed via: sudo bin/sync-env --umans-key "sk-..." --hyper-key "sk-hyper-..." [--opencode-key "oc_sk_..."]
# Or set up from scratch via: sudo bin/setup-env --umans-key "sk-..." --hyper-key "sk-hyper-..." [--opencode-key "oc_sk_..."]

# ─── Ports ───────────────────────────────────────────────────────────────────
# Backend HTTP (serves API + frontend static files)
BACKEND_PORT=24991
# Surface WebSocket (frontend live updates + surfaces)
SURFACE_WS_PORT=24990

# ─── Network (inbound: loopback + Tailscale only; no Docker bridges) ───────────
DISPATCH_BIND=loopback,tailscale
# Optional fallback when automatic Tailscale name discovery is unavailable.
# DISPATCH_TAILSCALE_NAME=workstation.example
# Additive allowed Host/Origin hostnames, comma-separated (never URLs).
# DISPATCH_ALLOWED_HOSTS=extra-tailnet-name
# DISPATCH_BIND also accepts literal IPs, DNS names, or all (unsafe; warns).

# ─── Frontend ────────────────────────────────────────────────────────────────
# Directory containing the built frontend static files (served by the backend)
DISPATCH_WEB_DIR=/usr/share/dispatch/web

# ─── OpenCode provider (optional, set key to enable) ─────────────────────────
# Set the key via: sudo bin/sync-env --opencode-key "oc_sk_..."
#   (or run `sudo bin/sync-env` with no arguments and paste it at the prompt)
# Remove/disable via: sudo bin/sync-env --opencode-key ""
# ONE unnumbered key registers the provider + credential `opencode` (models are
# `opencode/<model>`) and feeds the OpenCode card of the usage sidebar. The old
# numbered OPENCODE_API_KEY_<n> variables are obsolete (ignored with a warning);
# the original DISPATCH_API_KEY path is gone and NOT supported (boot refuses it).
# OPENCODE_API_KEY=oc_sk_...
# Base URL + default model for the OpenCode credential:
DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1
DISPATCH_MODEL=deepseek-v4.1-flash

# ─── Umans provider ──────────────────────────────────────────────────────────
# Set the key via: sudo bin/sync-env --umans-key "sk-..."
UMANS_API_KEY=sk-...

# ─── Codex / OpenAI subscription (bundled at build time) ─────────────────────
# The codex extension is compiled into the binary when ../codex is present at
# build time. Set these to configure the model and credential.
# DISPATCH_OPENAI_MODEL=codex-mini-latest
# Model used by the Codex web-search backend; default: the Codex default model.
# DISPATCH_SEARCH_CODEX_MODEL=codex-mini-latest
# DISPATCH_CODEX_CREDENTIAL_KEY=...
# DISPATCH_CODEX_CREDENTIAL=codex

# ─── Claude / Anthropic subscription (bundled at build time) ──────────────────
# The claude extension is compiled into the binary when ../claude is present at
# build time. Set these to configure the model and credential.
# DISPATCH_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Model used by the Claude web-search backend; default: newest Haiku.
# DISPATCH_SEARCH_CLAUDE_MODEL=claude-haiku-5-5
# DISPATCH_CLAUDE_CREDENTIAL_KEY=...
# DISPATCH_CLAUDE_CREDENTIAL=claude

# ─── LongCat provider (optional, set key to enable) ──────────────────────────
# LONGCAT_API_KEY=sk-...

# ─── Hyper provider (optional, set key to enable) ─────────────────────────────
# Set the key via: sudo bin/sync-env --hyper-key "sk-hyper-..."
# Remove/disable via: sudo bin/sync-env --hyper-key ""
# Optional overrides (edit manually or via env):
# HYPER_BASE_URL=https://hyper.charm.land/v1
# HYPER_MODEL=deepseek-v4-flash
# HYPER_API_KEY=sk-...

# ─── Baseten provider (optional, set key to enable) ──────────────────────────
# Set the key via: sudo bin/sync-env --baseten-key "..."
# Remove/disable via: sudo bin/sync-env --baseten-key ""
# Optional overrides (edit manually or via env):
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-Fast
# BASETEN_API_KEY=...

# ─── Systalyze provider (optional, set key to enable) ────────────────────────
# Set the key via: sudo bin/sync-env --systalyze-key "stlzi_..."
# Or interactively: bin/set-systalyze-key
# Remove/disable via: sudo bin/sync-env --systalyze-key ""
# The vendor's own docs/examples call the key STLZ_API_KEY; that name is
# accepted as a fallback alias if SYSTALYZE_API_KEY is unset.
# Optional overrides (edit manually or via env):
# SYSTALYZE_BASE_URL=https://inference.systalyze.com/v1
# SYSTALYZE_MODEL=moonshotai/Kimi-K3
# SYSTALYZE_API_KEY=stlzi_...

# ─── Request size ────────────────────────────────────────────────────────────
# Largest request body sent to an OpenAI-compatible provider, in MB (decimals
# allowed). Above it the OLDEST attached images are dropped from the request.
# Default 9.5. Set 0 for no limit.
# DISPATCH_MAX_REQUEST_BODY_MB=9.5

# ─── Data paths ──────────────────────────────────────────────────────────────
DISPATCH_DB=/var/lib/dispatch/dispatch.db
DISPATCH_TRACE_DB=/var/lib/dispatch/traces.db
DISPATCH_JOURNAL=/var/log/dispatch/app.ndjson
# Images default to <directory of DISPATCH_DB>/images; independent override:
# DISPATCH_IMAGE_DIR=/var/lib/dispatch/images
# Retain image bytes for 7 days (0 = forever). Sweep at boot and every 6 hours.
# Closing a tab preserves images; cached transcriptions survive expiry.
DISPATCH_IMAGE_RETENTION_DAYS=7

# ─── Discord bridge (Felicity agent API; optional) ───────────────────────────
# Both set → the bundled discord-bridge plugin relays Discord chat threads
# (`!dispatch open <id> [count]` in Discord) with existing conversations.
# Either unset → the plugin stays inert and logs why. The same two variables
# are used by agents through the global `discord` skill (the local shell tool
# passes the server environment through). The API is tailnet-only (xenifse1).
# Generate the token with `openssl rand -hex 32`; Felicity stores only its
# SHA-256 (AGENT_API_TOKEN_SHA256 in Dokploy). Never commit the real token.
# FELICITY_API_URL=http://100.102.55.49:27431
# FELICITY_API_TOKEN=...

# Self-hosted tools — override locally if services are on another machine.
# Defaults are loopback; keep private addresses out of Git.
# FIRECRAWL_BASE_URL=http://127.0.0.1:31329/v1
# YOUTUBE_TRANSCRIBER_URL=http://127.0.0.1:41090
