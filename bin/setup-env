#!/usr/bin/env bash
# bin/setup-env — create /etc/dispatch/env from scratch (or refresh it).
# Run this once before bin/install (or after, to refresh the config).
#
# Keys are NEVER read from .env or stored in the repo. They are passed as
# arguments or prompted interactively and written directly to /etc/dispatch/env.
# Secret values are never echoed — not even their prefixes (only the provider /
# credential NUMBER is reported).
#
# Usage:
#   sudo bin/setup-env --umans-key "sk-..." --longcat-key "ak-..." \
#     --opencode-key "1=sk-..." --opencode-key "3=sk-..."
#   sudo bin/setup-env                          # prompts for keys interactively
#
# Numbered OpenCode keys: pass `--opencode-key <number>=<key>` per numbered
# credential (numbers are stable identities; gaps allowed). On a REFRESH the
# existing numbered keys are PRESERVED unless you explicitly re-pass a number
# (to replace its key) or pass an empty value for a number (to remove it):
#   --opencode-key "1=sk-new"        # replace #1 with a new key
#   --opencode-key "3="              # remove #3 (explicit removal)
# Untouched numbered keys survive a refresh — a refresh NEVER silently deletes
# numbered keys on its own.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
ENV_FILE="/etc/dispatch/env"

if [[ "$(id -u)" -ne 0 ]]; then
	echo "setup-env: must run as root (use sudo)" >&2
	exit 1
fi

mkdir -p /etc/dispatch /var/lib/dispatch /var/log/dispatch

# --- Parse arguments ---
UMANS_KEY=""
LONGCAT_KEY=""
# Maps a canonical OpenCode number → value. Empty value means "removal".
declare -A OPENCODE_MAP=()
# A helper that validates + records one <number>=<key> argument. Last-wins for
# a repeated number (deterministic canonicalization of duplicates).
add_opencode() {
	local pair="$1"
	local NUM VAL
	if [[ "$pair" != *=* ]]; then
		# Missing '=' separator — e.g. a bare number or key was passed.
		echo "setup-env: --opencode-key expects '<number>=<key>' (got '${pair}' with no '=' separator)" >&2
		exit 1
	fi
	NUM="${pair%%=*}"
	VAL="${pair#*=}"
	if [[ ! "$NUM" =~ ^[1-9][0-9]*$ ]]; then
		echo "setup-env: invalid OpenCode number '${NUM}' (must be a canonical positive integer [1-9][0-9]*, no leading zero)" >&2
		exit 1
	fi
	# Reject values that would corrupt the env file or downstream sed/awk
	# processing. A team key never contains these.
	if [[ "$VAL" == *$'\n'* || "$VAL" == *$'\r'* || "$VAL" == *=* || "$VAL" == *'|'* ]]; then
		echo "setup-env: OpenCode key for number ${NUM} contains unsafe characters (newline/CR/'='/pipe) — refusing" >&2
		exit 1
	fi
	OPENCODE_MAP["$NUM"]="$VAL"
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--umans-key)
			UMANS_KEY="$2"
			shift 2
			;;
		--umans-key=*)
			UMANS_KEY="${1#--umans-key=}"
			shift
			;;
		--longcat-key)
			LONGCAT_KEY="$2"
			shift 2
			;;
		--longcat-key=*)
			LONGCAT_KEY="${1#--longcat-key=}"
			shift
			;;
		--opencode-key)
			add_opencode "$2"
			shift 2
			;;
		--opencode-key=*)
			add_opencode "${1#--opencode-key=}"
			shift
			;;
		*)
			echo "setup-env: unknown argument: $1" >&2
			echo "Usage: sudo bin/setup-env [--umans-key \"sk-...\"] [--longcat-key \"ak-...\"] [--opencode-key \"1=sk-...\"]" >&2
			exit 1
			;;
	esac
done

# --- Prompt for keys if not provided via arguments ---
if [ -z "$UMANS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter UMANS_API_KEY (or press Enter to skip): "
	read -r UMANS_KEY
fi
if [ -z "$LONGCAT_KEY" ] && [ -t 0 ]; then
	echo -n "Enter LONGCAT_API_KEY (or press Enter to skip): "
	read -r LONGCAT_KEY
fi

# Resolve the real user's home dir (the service runs as this user — see bin/install)
REAL_USER="${SUDO_USER:-$USER}"
REAL_GROUP=$(id -gn "$REAL_USER" 2>/dev/null || echo "$REAL_USER")
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
if [[ -z "$REAL_HOME" ]]; then
	echo "setup-env: could not resolve home for user '$REAL_USER'" >&2
	exit 1
fi

# Ensure data dirs are owned by the real user (the service runs as them)
mkdir -p /var/lib/dispatch /var/log/dispatch
chown -R "$REAL_USER:$REAL_GROUP" /var/lib/dispatch /var/log/dispatch

# PATH that includes user-installed tools
DISPATCH_PATH="/home/PII_REDACTED_USER_01/.local/bin:/home/PII_REDACTED_USER_01/.local/share/mise/shims:/home/PII_REDACTED_USER_01/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

# --- Merge existing numbered OpenCode keys on a REFRESH (issue: never silently
# --- delete numbered keys). Read the current env file's OPENCODE_API_KEY_<n>
# --- lines and carry forward any number NOT explicitly provided on this run.
# --- A number passed with an empty value is an explicit removal. A number
# --- passed with a value is an explicit replacement. Everything else survives.
if [ -f "$ENV_FILE" ]; then
	while IFS= read -r line; do
		[[ "$line" == OPENCODE_API_KEY_* ]] || continue
		line="${line%%$'\r'*}" # strip any CR to keep numbers clean (env files are LF)
		key="${line%%=*}"
		val="${line#*=}"
		num="${key#OPENCODE_API_KEY_}"
		# Only carry forward CANONICAL numbered keys (ignore obsolete/malformed
		# lines — boot would reject them anyway).
		if [[ "$num" =~ ^[1-9][0-9]*$ ]]; then
			if [[ -z "${OPENCODE_MAP[$num]+x}" ]]; then
				OPENCODE_MAP["$num"]="$val"
			fi
		fi
	done < "$ENV_FILE"
fi

# Sorted numeric list of every carry forward / provided key (stable output).
mapfile -t OPENCODE_NUMBERS < <(
	for n in "${!OPENCODE_MAP[@]}"; do
		printf '%s\n' "$n"
	done | sort -n
)

# Build the numbered OpenCode lines (each on its own numbered var). A key with
# an EMPTY value means it was explicitly removed → emit nothing for it.
OPENCODE_LINES=""
for NUM in "${OPENCODE_NUMBERS[@]}"; do
	VAL="${OPENCODE_MAP[$NUM]}"
	if [ -n "$VAL" ]; then
		OPENCODE_LINES="${OPENCODE_LINES}OPENCODE_API_KEY_${NUM}=${VAL}
"
	fi
done

# Write the system env file
tee "$ENV_FILE" > /dev/null << EOF
# /etc/dispatch/env — Dispatch server configuration (systemd EnvironmentFile)
# Generated by bin/setup-env
# Edit manually, then: systemctl restart dispatch
# Keys are managed via: sudo bin/sync-env --umans-key "sk-..." [--longcat-key "ak-..."] [--opencode-key "1=sk-..."]

# ─── User environment (service runs as $REAL_USER, homedir is correct) ───────
HOME=$REAL_HOME
PATH=$DISPATCH_PATH

# ─── Ports ───────────────────────────────────────────────────────────────────
BACKEND_PORT=24991
SURFACE_WS_PORT=24990

# ─── Frontend ────────────────────────────────────────────────────────────────
DISPATCH_WEB_DIR=/usr/share/dispatch/web

# ─── Numbered OpenCode provider ───────────────────────────────────────────────
${OPENCODE_LINES}${OPENCODE_LINES:+# (each number registers opencode-<n> provider + credential)}
${OPENCODE_LINES:+DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1}
${OPENCODE_LINES:+DISPATCH_MODEL=deepseek-v4-flash}

# ─── Umans provider ──────────────────────────────────────────────────────────
${UMANS_KEY:+UMANS_API_KEY=$UMANS_KEY}

# ─── LongCat provider ────────────────────────────────────────────────────────
${LONGCAT_KEY:+LONGCAT_API_KEY=$LONGCAT_KEY}

# ─── Data paths ──────────────────────────────────────────────────────────────
DISPATCH_DB=/var/lib/dispatch/dispatch.db
DISPATCH_TRACE_DB=/var/lib/dispatch/traces.db
DISPATCH_JOURNAL=/var/log/dispatch/app.ndjson
EOF

# Set permissions: root:PII_REDACTED_USER_01 640 (PII_REDACTED_USER_01 can read for dev via bin/up)
chown root:"$REAL_GROUP" "$ENV_FILE"
chmod 640 "$ENV_FILE"

echo "[setup-env] wrote $ENV_FILE"
echo "  HOME=$REAL_HOME (skills: $REAL_HOME/.skills/)"
${UMANS_KEY:+echo "  UMANS_API_KEY configured (value not echoed)"}
${LONGCAT_KEY:+echo "  LONGCAT_API_KEY configured (value not echoed)"}
if [ "${#OPENCODE_MAP[@]}" -gt 0 ]; then
	echo "  OpenCode numbered keys: ${OPENCODE_NUMBERS[*]} (values not echoed)"
fi
echo "  Ports: HTTP=24991 WS=24990"
echo "  Data:  /var/lib/dispatch/ + /var/log/dispatch/"
echo "  Perms: 640 root:$REAL_GROUP (PII_REDACTED_USER_01 can read for dev)"