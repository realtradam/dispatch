#!/usr/bin/env bash
# bin/setup-env — create /etc/dispatch/env from scratch (or refresh it).
# Run this once before bin/install (or after, to refresh the config).
#
# Keys are NEVER read from .env or stored in the repo. They are passed as
# arguments or prompted interactively and written directly to /etc/dispatch/env.
# Secret values are never echoed — not even their prefixes (only the provider
# is reported).
#
# Usage:
#   sudo bin/setup-env --umans-key "sk-..." --longcat-key "ak-..." \
#     --hyper-key "sk-hyper-..." --opencode-key "oc_sk_..."
#   sudo bin/setup-env                          # prompts for keys interactively
#
# OpenCode key: ONE unnumbered key, `--opencode-key <key>` → OPENCODE_API_KEY.
# On a REFRESH the existing OPENCODE_API_KEY is PRESERVED unless you explicitly
# re-pass it (to replace the key) or pass an empty value (to remove it):
#   --opencode-key "oc_sk_new"       # replace the key
#   --opencode-key ""                # remove it (explicit removal)
# Obsolete numbered OPENCODE_API_KEY_<n> lines are NOT carried over — the server
# ignores them.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
ENV_FILE="/etc/dispatch/env"

if [[ "$(id -u)" -ne 0 ]]; then
	echo "setup-env: must run as root (use sudo)" >&2
	exit 1
fi

mkdir -p /etc/dispatch /var/lib/dispatch /var/log/dispatch

# --- Parse arguments ---
UMANS_KEY=""
LONGCAT_KEY=""
HYPER_KEY=""
# Whether --opencode-key was explicitly supplied on this run (or entered at the
# prompt). Supplied + empty means REMOVE; not supplied means keep the existing key.
OPENCODE_KEY=""
OPENCODE_KEY_SET=0
# Refuse an OpenCode key that could corrupt the env file. A real key
# (`oc_sk_…` / `sk-…`) never contains any of these characters.
check_opencode_key() {
	local val="$1"
	if [[ "$val" == *=* ]]; then
		echo "setup-env: the OpenCode key contains '=' — refusing. OpenCode takes ONE unnumbered key now: pass the key itself, not '<number>=<key>'." >&2
		exit 1
	fi
	if [[ "$val" =~ [[:space:]] || "$val" == *'|'* || "$val" == *'&'* || "$val" == *'\'* ]]; then
		echo "setup-env: the OpenCode key contains unsafe characters (whitespace/pipe/ampersand/backslash) — refusing (was it double-pasted?)" >&2
		exit 1
	fi
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--umans-key)
			UMANS_KEY="$2"
			shift 2
			;;
		--umans-key=*)
			UMANS_KEY="${1#--umans-key=}"
			shift
			;;
		--longcat-key)
			LONGCAT_KEY="$2"
			shift 2
			;;
		--longcat-key=*)
			LONGCAT_KEY="${1#--longcat-key=}"
			shift
			;;
		--hyper-key)
			HYPER_KEY="$2"
			shift 2
			;;
		--hyper-key=*)
			HYPER_KEY="${1#--hyper-key=}"
			shift
			;;
		--opencode-key)
			OPENCODE_KEY="$2"
			OPENCODE_KEY_SET=1
			shift 2
			;;
		--opencode-key=*)
			OPENCODE_KEY="${1#--opencode-key=}"
			OPENCODE_KEY_SET=1
			shift
			;;
		*)
			echo "setup-env: unknown argument: $1" >&2
			echo "Usage: sudo bin/setup-env [--umans-key \"sk-...\"] [--longcat-key \"ak-...\"] [--hyper-key \"sk-hyper-...\"] [--opencode-key \"oc_sk_...\"]" >&2
			exit 1
			;;
	esac
done

# --- Prompt for keys if not provided via arguments ---
if [ -z "$UMANS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter UMANS_API_KEY (or press Enter to skip): "
	read -r UMANS_KEY
fi
if [ -z "$LONGCAT_KEY" ] && [ -t 0 ]; then
	echo -n "Enter LONGCAT_API_KEY (or press Enter to skip): "
	read -r LONGCAT_KEY
fi
if [ -z "$HYPER_KEY" ] && [ -t 0 ]; then
	echo -n "Enter HYPER_API_KEY (or press Enter to skip): "
	read -r HYPER_KEY
fi
if [ -z "$OPENCODE_KEY" ] && [ -t 0 ]; then
	# Hidden input (`read -s`): the pasted key is never echoed to the terminal.
	echo -n "Enter OPENCODE_API_KEY — paste it, input is hidden (or press Enter to keep the current one): "
	IFS= read -rs OPENCODE_KEY
	echo
	if [ -n "$OPENCODE_KEY" ]; then
		OPENCODE_KEY_SET=1
	fi
fi
check_opencode_key "$OPENCODE_KEY"

# Resolve the real user's home dir (the service runs as this user — see bin/install)
REAL_USER="${SUDO_USER:-$USER}"
REAL_GROUP=$(id -gn "$REAL_USER" 2>/dev/null || echo "$REAL_USER")
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
if [[ -z "$REAL_HOME" ]]; then
	echo "setup-env: could not resolve home for user '$REAL_USER'" >&2
	exit 1
fi

# Ensure data dirs are owned by the real user (the service runs as them)
mkdir -p /var/lib/dispatch /var/log/dispatch
chown -R "$REAL_USER:$REAL_GROUP" /var/lib/dispatch /var/log/dispatch

# PATH that includes user-installed tools
DISPATCH_PATH="$REAL_HOME/.local/bin:$REAL_HOME/.local/share/mise/shims:$REAL_HOME/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

# --- Keep the existing OpenCode key on a REFRESH (never silently delete it).
# --- Read the current env file's OPENCODE_API_KEY line as data and carry it
# --- forward unless a key was explicitly provided on this run (a value
# --- replaces it; an empty value removes it). Obsolete numbered
# --- OPENCODE_API_KEY_<n> lines are deliberately NOT carried forward.
if [ "$OPENCODE_KEY_SET" -eq 0 ] && [ -f "$ENV_FILE" ]; then
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ "$line" == OPENCODE_API_KEY=* ]] || continue
		line="${line%%$'\r'*}" # strip any CR (env files are LF)
		OPENCODE_KEY="${line#OPENCODE_API_KEY=}"
	done < "$ENV_FILE"
fi

# Keep local service endpoints and network policy across a setup refresh. Never
# source this file as root: copy assignments as data, including explicit blanks.
# Endpoints belong here (not in the binary/repo), shared by systemd and bin/up.
LOCAL_SERVICE_CONFIG=""
if [ -f "$ENV_FILE" ]; then
	while IFS= read -r line || [[ -n "$line" ]]; do
		case "$line" in
			FIRECRAWL_BASE_URL=*|YOUTUBE_TRANSCRIBER_URL=*|DISPATCH_BIND=*|DISPATCH_TAILSCALE_NAME=*|DISPATCH_ALLOWED_HOSTS=*)
				LOCAL_SERVICE_CONFIG+="$line"$'\n'
				;;
		esac
	done < "$ENV_FILE"
fi

# Write the system env file
tee "$ENV_FILE" > /dev/null << EOF
# /etc/dispatch/env — Dispatch server configuration (systemd EnvironmentFile)
# Generated by bin/setup-env
# Edit manually, then: systemctl restart dispatch
# Keys are managed via: sudo bin/sync-env --umans-key "sk-..." [--longcat-key "ak-..."] [--opencode-key "oc_sk_..."]

# ─── User environment (service runs as $REAL_USER, homedir is correct) ───────
HOME=$REAL_HOME
PATH=$DISPATCH_PATH

# ─── Ports ───────────────────────────────────────────────────────────────────
BACKEND_PORT=24991
SURFACE_WS_PORT=24990

# ─── Frontend ────────────────────────────────────────────────────────────────
DISPATCH_WEB_DIR=/usr/share/dispatch/web

# ─── OpenCode provider (one key; models are opencode/<model>) ─────────────────
${OPENCODE_KEY:+OPENCODE_API_KEY=$OPENCODE_KEY}
${OPENCODE_KEY:+DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1}
${OPENCODE_KEY:+DISPATCH_MODEL=deepseek-v4.1-flash}

# ─── Umans provider ──────────────────────────────────────────────────────────
${UMANS_KEY:+UMANS_API_KEY=$UMANS_KEY}

# ─── LongCat provider ────────────────────────────────────────────────────────
${LONGCAT_KEY:+LONGCAT_API_KEY=$LONGCAT_KEY}

# ─── Hyper provider (optional, set key to enable) ────────────────────────────
${HYPER_KEY:+HYPER_API_KEY=$HYPER_KEY}

# ─── Local service endpoints + network overrides (preserved on refresh) ──────
${LOCAL_SERVICE_CONFIG}
# ─── Data paths ──────────────────────────────────────────────────────────────
DISPATCH_DB=/var/lib/dispatch/dispatch.db
DISPATCH_TRACE_DB=/var/lib/dispatch/traces.db
DISPATCH_JOURNAL=/var/log/dispatch/app.ndjson
EOF

# Set permissions: root + the service user's group (readable by bin/up)
chown root:"$REAL_GROUP" "$ENV_FILE"
chmod 640 "$ENV_FILE"

echo "[setup-env] wrote $ENV_FILE"
echo "  HOME=$REAL_HOME (skills: $REAL_HOME/.skills/)"
${UMANS_KEY:+echo "  UMANS_API_KEY configured (value not echoed)"}
${LONGCAT_KEY:+echo "  LONGCAT_API_KEY configured (value not echoed)"}
${HYPER_KEY:+echo "  HYPER_API_KEY configured (value not echoed)"}
${OPENCODE_KEY:+echo "  OPENCODE_API_KEY configured (value not echoed)"}
echo "  Ports: HTTP=24991 WS=24990"
echo "  Data:  /var/lib/dispatch/ + /var/log/dispatch/"
echo "  Perms: 640 root:$REAL_GROUP (service user can read for dev)"
