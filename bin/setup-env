#!/usr/bin/env bash
# bin/setup-env — create /etc/dispatch/env from scratch (or refresh it).
# Run this once before bin/install (or after, to refresh the config).
#
# Keys are NEVER read from .env or stored in the repo. They are passed as
# arguments or prompted interactively and written directly to /etc/dispatch/env.
#
# Usage:
#   sudo bin/setup-env --umans-key "sk-..." --longcat-key "ak-..." \
#     --opencode-key "1=sk-..." --opencode-key "3=sk-..."
#   sudo bin/setup-env                          # prompts for keys interactively
#
# Numbered OpenCode keys: pass `--opencode-key <number>=<key>` per numbered
# credential (numbers are stable identities; gaps allowed). Values are written
# straight to the env file and never echoed in full.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"

if [[ "$(id -u)" -ne 0 ]]; then
	echo "setup-env: must run as root (use sudo)" >&2
	exit 1
fi

mkdir -p /etc/dispatch /var/lib/dispatch /var/log/dispatch

# --- Parse arguments ---
UMANS_KEY=""
LONGCAT_KEY=""
declare -a OPENCODE_NUMBERS=()
declare -a OPENCODE_VALUES=()
while [[ $# -gt 0 ]]; do
	case "$1" in
		--umans-key)
			UMANS_KEY="$2"
			shift 2
			;;
		--umans-key=*)
			UMANS_KEY="${1#--umans-key=}"
			shift
			;;
		--longcat-key)
			LONGCAT_KEY="$2"
			shift 2
			;;
		--longcat-key=*)
			LONGCAT_KEY="${1#--longcat-key=}"
			shift
			;;
		--opencode-key)
			# Value is "<number>=<key>".
			NUM="${2%%=*}"
			VAL="${2#*=}"
			if [[ ! "$NUM" =~ ^[1-9][0-9]*$ ]]; then
				echo "setup-env: invalid OpenCode number in '$2' (must be a positive integer)" >&2
				exit 1
			fi
			if [[ -z "$VAL" ]]; then
				echo "setup-env: empty OpenCode key for number $NUM" >&2
				exit 1
			fi
			OPENCODE_NUMBERS+=("$NUM")
			OPENCODE_VALUES+=("$VAL")
			shift 2
			;;
		--opencode-key=*)
			PAIR="${1#--opencode-key=}"
			NUM="${PAIR%%=*}"
			VAL="${PAIR#*=}"
			if [[ ! "$NUM" =~ ^[1-9][0-9]*$ ]]; then
				echo "setup-env: invalid OpenCode number in '$PAIR' (must be a positive integer)" >&2
				exit 1
			fi
			if [[ -z "$VAL" ]]; then
				echo "setup-env: empty OpenCode key for number $NUM" >&2
				exit 1
			fi
			OPENCODE_NUMBERS+=("$NUM")
			OPENCODE_VALUES+=("$VAL")
			shift
			;;
		*)
			echo "setup-env: unknown argument: $1" >&2
			echo "Usage: sudo bin/setup-env [--umans-key \"sk-...\"] [--longcat-key \"ak-...\"] [--opencode-key \"1=sk-...\"]" >&2
			exit 1
			;;
	esac
done

# --- Prompt for keys if not provided via arguments ---
if [ -z "$UMANS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter UMANS_API_KEY (or press Enter to skip): "
	read -r UMANS_KEY
fi
if [ -z "$LONGCAT_KEY" ] && [ -t 0 ]; then
	echo -n "Enter LONGCAT_API_KEY (or press Enter to skip): "
	read -r LONGCAT_KEY
fi

# Resolve the real user's home dir (the service runs as this user — see bin/install)
REAL_USER="${SUDO_USER:-$USER}"
REAL_GROUP=$(id -gn "$REAL_USER" 2>/dev/null || echo "$REAL_USER")
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
if [[ -z "$REAL_HOME" ]]; then
	echo "setup-env: could not resolve home for user '$REAL_USER'" >&2
	exit 1
fi

# Ensure data dirs are owned by the real user (the service runs as them)
mkdir -p /var/lib/dispatch /var/log/dispatch
chown -R "$REAL_USER:$REAL_GROUP" /var/lib/dispatch /var/log/dispatch

# PATH that includes user-installed tools
DISPATCH_PATH="/home/PII_REDACTED_USER_01/.local/bin:/home/PII_REDACTED_USER_01/.local/share/mise/shims:/home/PII_REDACTED_USER_01/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

# Build the numbered OpenCode lines (each on its own numbered var).
OPENCODE_LINES=""
i=0
for NUM in "${OPENCODE_NUMBERS[@]}"; do
	VAL="${OPENCODE_VALUES[$i]}"
	OPENCODE_LINES="${OPENCODE_LINES}OPENCODE_API_KEY_${NUM}=${VAL}
"
	i=$((i + 1))
done

# Write the system env file
tee /etc/dispatch/env > /dev/null << EOF
# /etc/dispatch/env — Dispatch server configuration (systemd EnvironmentFile)
# Generated by bin/setup-env
# Edit manually, then: systemctl restart dispatch
# Keys are managed via: sudo bin/sync-env --umans-key "sk-..." [--longcat-key "ak-..."] [--opencode-key "1=sk-..."]

# ─── User environment (service runs as $REAL_USER, homedir is correct) ───────
HOME=$REAL_HOME
PATH=$DISPATCH_PATH

# ─── Ports ───────────────────────────────────────────────────────────────────
BACKEND_PORT=24991
SURFACE_WS_PORT=24990

# ─── Frontend ────────────────────────────────────────────────────────────────
DISPATCH_WEB_DIR=/usr/share/dispatch/web

# ─── Numbered OpenCode provider ───────────────────────────────────────────────
${OPENCODE_LINES}${OPENCODE_LINES:+# (each number registers opencode-<n> provider + credential)}
${OPENCODE_LINES:+DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1}
${OPENCODE_LINES:+DISPATCH_MODEL=deepseek-v4-flash}

# ─── Umans provider ──────────────────────────────────────────────────────────
${UMANS_KEY:+UMANS_API_KEY=$UMANS_KEY}

# ─── LongCat provider ────────────────────────────────────────────────────────
${LONGCAT_KEY:+LONGCAT_API_KEY=$LONGCAT_KEY}

# ─── Data paths ──────────────────────────────────────────────────────────────
DISPATCH_DB=/var/lib/dispatch/dispatch.db
DISPATCH_TRACE_DB=/var/lib/dispatch/traces.db
DISPATCH_JOURNAL=/var/log/dispatch/app.ndjson
EOF

# Set permissions: root:PII_REDACTED_USER_01 640 (PII_REDACTED_USER_01 can read for dev via bin/up)
chown root:"$REAL_GROUP" /etc/dispatch/env
chmod 640 /etc/dispatch/env

echo "[setup-env] wrote /etc/dispatch/env"
echo "  HOME=$REAL_HOME (skills: $REAL_HOME/.skills/)"
${UMANS_KEY:+echo "  UMANS_API_KEY=${UMANS_KEY:0:8}..."}
${LONGCAT_KEY:+echo "  LONGCAT_API_KEY=${LONGCAT_KEY:0:8}..."}
if [ -n "$OPENCODE_LINES" ]; then
	echo "  OpenCode numbered keys: ${OPENCODE_NUMBERS[*]} (values not echoed)"
fi
echo "  Ports: HTTP=24991 WS=24990"
echo "  Data:  /var/lib/dispatch/ + /var/log/dispatch/"
echo "  Perms: 640 root:$REAL_GROUP (PII_REDACTED_USER_01 can read for dev)"