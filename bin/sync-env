#!/bin/bash
# bin/sync-env — update /etc/dispatch/env with keys + system paths.
#
# Keys are NEVER stored in this file or in the repo. They are passed as
# arguments (or prompted interactively) and written directly to /etc/dispatch/env.
# Secret values are never echoed — not even their prefixes (only the provider /
# credential NUMBER is reported).
#
# Usage:
#   sudo bin/sync-env --umans-key "sk-..." --longcat-key "ak-..." --opencode-key "1=sk-..."
#   sudo bin/sync-env                          # prompts for keys interactively
#   sudo bin/sync-env --umans-key ""           # removes the umans key (writes UMANS_API_KEY=)
#   sudo bin/sync-env --opencode-key "1="      # removes numbered OpenCode key #1
#
# Numbered OpenCode keys: `--opencode-key <number>=<key>`. An empty value
# removes that number. Numbers are stable identities; gaps are preserved. A
# repeated number is canonicalized last-wins. Values with newlines/CR/'='/pipe
# are rejected so they can never corrupt the env file or the sed edit.

set -euo pipefail

ENV_FILE="/etc/dispatch/env"
# PATH that includes user-installed tools (mise, bun, npm global, etc.)
DISPATCH_PATH="/home/PII_REDACTED_USER_01/.local/bin:/home/PII_REDACTED_USER_01/.local/share/mise/shims:/home/PII_REDACTED_USER_01/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

if [[ "$(id -u)" -ne 0 ]]; then
	echo "sync-env: must run as root (use sudo)" >&2
	exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
	echo "sync-env: $ENV_FILE not found — run 'sudo bin/setup-env' first" >&2
	exit 1
fi

# --- Parse arguments ---
UMANS_KEY=""
LONGCAT_KEY=""
# Maps a canonical OpenCode number → value. Empty value means "removal".
declare -A OPENCODE_MAP=()
add_opencode() {
	local pair="$1"
	local NUM VAL
	if [[ "$pair" != *=* ]]; then
		echo "sync-env: --opencode-key expects '<number>=<key>' (got '${pair}' with no '=' separator)" >&2
		exit 1
	fi
	NUM="${pair%%=*}"
	VAL="${pair#*=}"
	if [[ ! "$NUM" =~ ^[1-9][0-9]*$ ]]; then
		echo "sync-env: invalid OpenCode number '${NUM}' (must be a canonical positive integer [1-9][0-9]*, no leading zero)" >&2
		exit 1
	fi
	if [[ "$VAL" == *$'\n'* || "$VAL" == *$'\r'* || "$VAL" == *=* || "$VAL" == *'|'* ]]; then
		echo "sync-env: OpenCode key for number ${NUM} contains unsafe characters (newline/CR/'='/pipe) — refusing" >&2
		exit 1
	fi
	OPENCODE_MAP["$NUM"]="$VAL"
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--umans-key)
			UMANS_KEY="$2"
			shift 2
			;;
		--umans-key=*)
			UMANS_KEY="${1#--umans-key=}"
			shift
			;;
		--longcat-key)
			LONGCAT_KEY="$2"
			shift 2
			;;
		--longcat-key=*)
			LONGCAT_KEY="${1#--longcat-key=}"
			shift
			;;
		--opencode-key)
			add_opencode "$2"
			shift 2
			;;
		--opencode-key=*)
			add_opencode "${1#--opencode-key=}"
			shift
			;;
		*)
			echo "sync-env: unknown argument: $1" >&2
			echo "Usage: sudo bin/sync-env [--umans-key \"sk-...\"] [--longcat-key \"ak-...\"] [--opencode-key \"1=sk-...\"]" >&2
			exit 1
			;;
	esac
done

# --- Prompt for keys if not provided via arguments ---
if [ -z "$UMANS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter UMANS_API_KEY (or press Enter to skip): " >&2
	read -r UMANS_KEY
fi
if [ -z "$LONGCAT_KEY" ] && [ -t 0 ]; then
	echo -n "Enter LONGCAT_API_KEY (or press Enter to skip): " >&2
	read -r LONGCAT_KEY
fi

# --- Update PATH ---
if grep -q "^PATH=" "$ENV_FILE"; then
	sed -i "s|^PATH=.*|PATH=$DISPATCH_PATH|" "$ENV_FILE"
else
	echo "PATH=$DISPATCH_PATH" >> "$ENV_FILE"
fi

# --- Update UMANS_API_KEY (empty value → write empty line to disable) ---
if [ -n "$UMANS_KEY" ]; then
	if grep -q "^UMANS_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^UMANS_API_KEY=.*|UMANS_API_KEY=$UMANS_KEY|" "$ENV_FILE"
	else
		echo "UMANS_API_KEY=$UMANS_KEY" >> "$ENV_FILE"
	fi
fi
if [ -n "$UMANS_KEY" ]; then
	echo "  UMANS_API_KEY ${UMANS_KEY:+configured} (value not echoed)" >&2
fi

# --- Update LONGCAT_API_KEY (empty value → write empty line to disable) ---
if [ -n "$LONGCAT_KEY" ]; then
	if grep -q "^LONGCAT_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^LONGCAT_API_KEY=.*|LONGCAT_API_KEY=$LONGCAT_KEY|" "$ENV_FILE"
	else
		echo "LONGCAT_API_KEY=$LONGCAT_KEY" >> "$ENV_FILE"
	fi
fi
if [ -n "$LONGCAT_KEY" ]; then
	echo "  LONGCAT_API_KEY ${LONGCAT_KEY:+configured} (value not echoed)" >&2
fi

# --- Update numbered OpenCode keys (OPENCODE_API_KEY_<n>). Last-wins +
# --- deterministic: iterate the map in numeric order. Empty value → remove.
for NUM in $(printf '%s\n' "${!OPENCODE_MAP[@]}" | sort -n); do
	VAL="${OPENCODE_MAP[$NUM]}"
	VAR="OPENCODE_API_KEY_${NUM}"
	if [ -n "$VAL" ]; then
		if grep -q "^$VAR=" "$ENV_FILE"; then
			sed -i "s|^$VAR=.*|$VAR=$VAL|" "$ENV_FILE"
		else
			echo "$VAR=$VAL" >> "$ENV_FILE"
		fi
		echo "  $VAR configured (value not echoed)" >&2
	else
		# Empty value → remove the numbered key.
		sed -i "/^$VAR=/d" "$ENV_FILE"
		echo "  removed $VAR" >&2
	fi
done

# If any numbered OpenCode keys remain, make sure the shared defaults are present.
if grep -q "^OPENCODE_API_KEY_" "$ENV_FILE"; then
	if ! grep -q "^DISPATCH_BASE_URL=" "$ENV_FILE"; then
		echo "DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1" >> "$ENV_FILE"
	fi
	if ! grep -q "^DISPATCH_MODEL=" "$ENV_FILE"; then
		echo "DISPATCH_MODEL=deepseek-v4-flash" >> "$ENV_FILE"
	fi
fi

# --- Delete the old OpenCode key (obsolete — no longer supported) ---
sed -i "/^DISPATCH_API_KEY=/d" "$ENV_FILE"
# Delete the backup key line
sed -i "/^DISPATCH_API_KEY_OPENCODE2=/d" "$ENV_FILE"

# --- Set permissions: root:PII_REDACTED_USER_01 640 (PII_REDACTED_USER_01 can read for dev) ---
chown root:PII_REDACTED_USER_01 "$ENV_FILE" 2>/dev/null || true
chmod 640 "$ENV_FILE"

echo "Updated $ENV_FILE"