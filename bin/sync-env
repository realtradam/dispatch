#!/bin/bash
# bin/sync-env — update /etc/dispatch/env with keys + system paths.
#
# Keys are NEVER stored in this file or in the repo. They are passed as
# arguments (or prompted interactively) and written directly to /etc/dispatch/env.
# Secret values are never echoed — not even their prefixes (only the provider
# is reported).
#
# Usage:
#   sudo bin/sync-env --umans-key "sk-..." --longcat-key "ak-..." --hyper-key "sk-hyper-..." --openrouter-key "sk-or-v1-..." --baseten-key "..." --coralbricks-key "cb_..." --systalyze-key "stlzi_..." --opencode-key "oc_sk_..."
#   sudo bin/sync-env                          # prompts for keys interactively (incl. OPENCODE_API_KEY)
#   sudo bin/sync-env --umans-key ""           # removes the umans key (writes UMANS_API_KEY=)
#   sudo bin/sync-env --hyper-key ""           # removes the hyper key (disables the provider)
#   sudo bin/sync-env --openrouter-key ""      # removes the openrouter key (disables the provider)
#   sudo bin/sync-env --baseten-key ""         # removes the baseten key (disables the provider)
#   sudo bin/sync-env --coralbricks-key ""     # removes the coralbricks key (disables the provider)
#   sudo bin/sync-env --systalyze-key ""       # removes the systalyze key (disables the provider)
#   sudo bin/sync-env --opencode-key ""        # removes the opencode key (disables the provider)
#
# OpenCode key: ONE unnumbered key, `--opencode-key <key>` → OPENCODE_API_KEY
# (provider + models are named `opencode/<model>`). Setting or removing it also
# deletes any obsolete numbered OPENCODE_API_KEY_<n> lines — the server ignores
# those. A key containing whitespace, '=', '|', '&' or a backslash is rejected
# so it can never corrupt the env file or the sed edit (this also catches the
# old `<number>=<key>` form).

set -euo pipefail

ENV_FILE="/etc/dispatch/env"

if [[ "$(id -u)" -ne 0 ]]; then
	echo "sync-env: must run as root (use sudo)" >&2
	exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
	echo "sync-env: $ENV_FILE not found — run 'sudo bin/setup-env' first" >&2
	exit 1
fi

# Use the configured service home rather than the invoking root account's HOME.
# Read it as data, NEVER source a user-editable config in a privileged script.
REAL_HOME=$(awk -F= '/^HOME=/{sub(/^HOME=/, ""); print; exit}' "$ENV_FILE")
if [[ -z "$REAL_HOME" ]]; then
	REAL_HOME=$(getent passwd "${SUDO_USER:-$USER}" | cut -d: -f6)
fi
if [[ "$REAL_HOME" != /* || "$REAL_HOME" == *$'\n'* || "$REAL_HOME" == *'|'* ]]; then
	echo "sync-env: invalid or missing service HOME" >&2
	exit 1
fi
DISPATCH_PATH="$REAL_HOME/.local/bin:$REAL_HOME/.local/share/mise/shims:$REAL_HOME/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
# Preserve the group chosen by setup-env/install (dev needs read access).
REAL_GROUP=$(stat -c '%G' "$ENV_FILE")

# --- Parse arguments ---
UMANS_KEY=""
LONGCAT_KEY=""
HYPER_KEY=""
OPENROUTER_KEY=""
BASETEN_KEY=""
CORALBRICKS_KEY=""
# Whether --hyper-key was explicitly supplied on this run. Unlike umans/longcat
# (empty = skip), an explicitly empty --hyper-key means REMOVE the key.
HYPER_KEY_SET=0
# Whether --openrouter-key was explicitly supplied on this run. Same semantics
# as --hyper-key: explicitly empty means REMOVE the key.
OPENROUTER_KEY_SET=0
# Whether --baseten-key was explicitly supplied on this run. Same semantics
# as --hyper-key: explicitly empty means REMOVE the key.
BASETEN_KEY_SET=0
# Whether --coralbricks-key was explicitly supplied on this run. Same semantics
# as --baseten-key: explicitly empty means REMOVE the key.
CORALBRICKS_KEY_SET=0
# Whether --systalyze-key was explicitly supplied on this run. Same semantics
# as --hyper-key: explicitly empty means REMOVE the key.
SYSTALYZE_KEY=""
SYSTALYZE_KEY_SET=0
# Whether --opencode-key was explicitly supplied on this run. Same semantics
# as --hyper-key: explicitly empty means REMOVE the key.
OPENCODE_KEY=""
OPENCODE_KEY_SET=0
# Refuse an OpenCode key that could corrupt the env file or the sed edit below.
# A real key (`oc_sk_…` / `sk-…`) never contains any of these characters.
check_opencode_key() {
	local val="$1"
	if [[ "$val" == *=* ]]; then
		echo "sync-env: the OpenCode key contains '=' — refusing. OpenCode takes ONE unnumbered key now: pass the key itself, not '<number>=<key>'." >&2
		exit 1
	fi
	if [[ "$val" =~ [[:space:]] || "$val" == *'|'* || "$val" == *'&'* || "$val" == *'\'* ]]; then
		echo "sync-env: the OpenCode key contains unsafe characters (whitespace/pipe/ampersand/backslash) — refusing (was it double-pasted?)" >&2
		exit 1
	fi
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--umans-key)
			UMANS_KEY="$2"
			shift 2
			;;
		--umans-key=*)
			UMANS_KEY="${1#--umans-key=}"
			shift
			;;
		--longcat-key)
			LONGCAT_KEY="$2"
			shift 2
			;;
		--longcat-key=*)
			LONGCAT_KEY="${1#--longcat-key=}"
			shift
			;;
		--hyper-key)
			HYPER_KEY="$2"
			HYPER_KEY_SET=1
			shift 2
			;;
		--hyper-key=*)
			HYPER_KEY="${1#--hyper-key=}"
			HYPER_KEY_SET=1
			shift
			;;
		--openrouter-key)
			OPENROUTER_KEY="$2"
			OPENROUTER_KEY_SET=1
			shift 2
			;;
		--openrouter-key=*)
			OPENROUTER_KEY="${1#--openrouter-key=}"
			OPENROUTER_KEY_SET=1
			shift
			;;
		--baseten-key)
			BASETEN_KEY="$2"
			BASETEN_KEY_SET=1
			shift 2
			;;
		--baseten-key=*)
			BASETEN_KEY="${1#--baseten-key=}"
			BASETEN_KEY_SET=1
			shift
			;;
		--coralbricks-key)
			CORALBRICKS_KEY="$2"
			CORALBRICKS_KEY_SET=1
			shift 2
			;;
		--coralbricks-key=*)
			CORALBRICKS_KEY="${1#--coralbricks-key=}"
			CORALBRICKS_KEY_SET=1
			shift
			;;
		--systalyze-key)
			SYSTALYZE_KEY="$2"
			SYSTALYZE_KEY_SET=1
			shift 2
			;;
		--systalyze-key=*)
			SYSTALYZE_KEY="${1#--systalyze-key=}"
			SYSTALYZE_KEY_SET=1
			shift
			;;
		--opencode-key)
			OPENCODE_KEY="$2"
			OPENCODE_KEY_SET=1
			shift 2
			;;
		--opencode-key=*)
			OPENCODE_KEY="${1#--opencode-key=}"
			OPENCODE_KEY_SET=1
			shift
			;;
		*)
			echo "sync-env: unknown argument: $1" >&2
			echo "Usage: sudo bin/sync-env [--umans-key \"sk-...\"] [--longcat-key \"ak-...\"] [--hyper-key \"sk-hyper-...\"] [--openrouter-key \"sk-or-v1-...\"] [--baseten-key \"...\"] [--coralbricks-key \"cb_...\"] [--systalyze-key \"stlzi_...\"] [--opencode-key \"oc_sk_...\"]" >&2
			exit 1
			;;
	esac
done

# --- Prompt for keys if not provided via arguments ---
if [ -z "$UMANS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter UMANS_API_KEY (or press Enter to skip): " >&2
	read -r UMANS_KEY
fi
if [ -z "$LONGCAT_KEY" ] && [ -t 0 ]; then
	echo -n "Enter LONGCAT_API_KEY (or press Enter to skip): " >&2
	read -r LONGCAT_KEY
fi
if [ -z "$HYPER_KEY" ] && [ -t 0 ]; then
	echo -n "Enter HYPER_API_KEY (or press Enter to skip): " >&2
	read -r HYPER_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--hyper-key ""` argument removes the key.
	if [ -n "$HYPER_KEY" ]; then
		HYPER_KEY_SET=1
	fi
fi
if [ -z "$OPENROUTER_KEY" ] && [ -t 0 ]; then
	echo -n "Enter OPENROUTER_API_KEY (or press Enter to skip): " >&2
	read -r OPENROUTER_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--openrouter-key ""` argument removes the key.
	if [ -n "$OPENROUTER_KEY" ]; then
		OPENROUTER_KEY_SET=1
	fi
fi
if [ -z "$BASETEN_KEY" ] && [ -t 0 ]; then
	echo -n "Enter BASETEN_API_KEY (or press Enter to skip): " >&2
	read -r BASETEN_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--baseten-key ""` argument removes the key.
	if [ -n "$BASETEN_KEY" ]; then
		BASETEN_KEY_SET=1
	fi
fi
if [ -z "$CORALBRICKS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter CORAL_API_KEY (or press Enter to skip): " >&2
	read -r CORALBRICKS_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--coralbricks-key ""` argument removes the key.
	if [ -n "$CORALBRICKS_KEY" ]; then
		CORALBRICKS_KEY_SET=1
	fi
fi
if [ -z "$SYSTALYZE_KEY" ] && [ -t 0 ]; then
	echo -n "Enter SYSTALYZE_API_KEY (or press Enter to skip): " >&2
	read -r SYSTALYZE_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--systalyze-key ""` argument removes the key.
	if [ -n "$SYSTALYZE_KEY" ]; then
		SYSTALYZE_KEY_SET=1
	fi
fi

if [ -z "$OPENCODE_KEY" ] && [ -t 0 ]; then
	# Hidden input (`read -s`): the pasted key is never echoed to the terminal.
	echo -n "Enter OPENCODE_API_KEY — paste it, input is hidden (or press Enter to skip): " >&2
	IFS= read -rs OPENCODE_KEY
	echo >&2
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--opencode-key ""` argument removes the key.
	if [ -n "$OPENCODE_KEY" ]; then
		OPENCODE_KEY_SET=1
	fi
fi
check_opencode_key "$OPENCODE_KEY"

# --- Update PATH ---
if grep -q "^PATH=" "$ENV_FILE"; then
	sed -i "s|^PATH=.*|PATH=$DISPATCH_PATH|" "$ENV_FILE"
else
	echo "PATH=$DISPATCH_PATH" >> "$ENV_FILE"
fi

# --- Update UMANS_API_KEY (empty value → write empty line to disable) ---
if [ -n "$UMANS_KEY" ]; then
	if grep -q "^UMANS_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^UMANS_API_KEY=.*|UMANS_API_KEY=$UMANS_KEY|" "$ENV_FILE"
	else
		echo "UMANS_API_KEY=$UMANS_KEY" >> "$ENV_FILE"
	fi
fi
if [ -n "$UMANS_KEY" ]; then
	echo "  UMANS_API_KEY ${UMANS_KEY:+configured} (value not echoed)" >&2
fi

# --- Update LONGCAT_API_KEY (empty value → write empty line to disable) ---
if [ -n "$LONGCAT_KEY" ]; then
	if grep -q "^LONGCAT_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^LONGCAT_API_KEY=.*|LONGCAT_API_KEY=$LONGCAT_KEY|" "$ENV_FILE"
	else
		echo "LONGCAT_API_KEY=$LONGCAT_KEY" >> "$ENV_FILE"
	fi
fi
if [ -n "$LONGCAT_KEY" ]; then
	echo "  LONGCAT_API_KEY ${LONGCAT_KEY:+configured} (value not echoed)" >&2
fi

# --- Update HYPER_API_KEY. Distinguish "flag omitted" from "--hyper-key ''".
# --- Omitted → leave the key as-is. Non-empty value → update/append. Explicitly
# --- empty value → REMOVE the key (disables the provider).
if [ "$HYPER_KEY_SET" -eq 1 ]; then
	if [ -n "$HYPER_KEY" ]; then
		if grep -q "^HYPER_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^HYPER_API_KEY=.*|HYPER_API_KEY=$HYPER_KEY|" "$ENV_FILE"
		else
			echo "HYPER_API_KEY=$HYPER_KEY" >> "$ENV_FILE"
		fi
		echo "  HYPER_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^HYPER_API_KEY=/d" "$ENV_FILE"
		echo "  removed HYPER_API_KEY" >&2
	fi
fi

# --- Update OPENROUTER_API_KEY. Same semantics as HYPER_API_KEY: omitted →
# --- leave as-is; non-empty → update/append; explicitly empty → remove.
if [ "$OPENROUTER_KEY_SET" -eq 1 ]; then
	if [ -n "$OPENROUTER_KEY" ]; then
		if grep -q "^OPENROUTER_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^OPENROUTER_API_KEY=.*|OPENROUTER_API_KEY=$OPENROUTER_KEY|" "$ENV_FILE"
		else
			echo "OPENROUTER_API_KEY=$OPENROUTER_KEY" >> "$ENV_FILE"
		fi
		echo "  OPENROUTER_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^OPENROUTER_API_KEY=/d" "$ENV_FILE"
		echo "  removed OPENROUTER_API_KEY" >&2
	fi
fi

# --- Update BASETEN_API_KEY. Same semantics as HYPER_API_KEY: omitted →
# --- leave as-is; non-empty → update/append; explicitly empty → remove.
if [ "$BASETEN_KEY_SET" -eq 1 ]; then
	if [ -n "$BASETEN_KEY" ]; then
		if grep -q "^BASETEN_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^BASETEN_API_KEY=.*|BASETEN_API_KEY=$BASETEN_KEY|" "$ENV_FILE"
		else
			echo "BASETEN_API_KEY=$BASETEN_KEY" >> "$ENV_FILE"
		fi
		echo "  BASETEN_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^BASETEN_API_KEY=/d" "$ENV_FILE"
		echo "  removed BASETEN_API_KEY" >&2
	fi
fi

# --- Update CORAL_API_KEY. Same semantics as HYPER_API_KEY: omitted →
# --- leave as-is; non-empty → update/append; explicitly empty → remove.
if [ "$CORALBRICKS_KEY_SET" -eq 1 ]; then
	if [ -n "$CORALBRICKS_KEY" ]; then
		if grep -q "^CORAL_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^CORAL_API_KEY=.*|CORAL_API_KEY=$CORALBRICKS_KEY|" "$ENV_FILE"
		else
			echo "CORAL_API_KEY=$CORALBRICKS_KEY" >> "$ENV_FILE"
		fi
		echo "  CORAL_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^CORAL_API_KEY=/d" "$ENV_FILE"
		echo "  removed CORAL_API_KEY" >&2
	fi
fi

# --- Update SYSTALYZE_API_KEY. Same semantics as HYPER_API_KEY: omitted →
# --- leave as-is; non-empty → update/append; explicitly empty → remove.
if [ "$SYSTALYZE_KEY_SET" -eq 1 ]; then
	if [ -n "$SYSTALYZE_KEY" ]; then
		if grep -q "^SYSTALYZE_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^SYSTALYZE_API_KEY=.*|SYSTALYZE_API_KEY=$SYSTALYZE_KEY|" "$ENV_FILE"
		else
			echo "SYSTALYZE_API_KEY=$SYSTALYZE_KEY" >> "$ENV_FILE"
		fi
		echo "  SYSTALYZE_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^SYSTALYZE_API_KEY=/d" "$ENV_FILE"
		echo "  removed SYSTALYZE_API_KEY" >&2
	fi
fi

# --- Update OPENCODE_API_KEY (the single unnumbered OpenCode key). Same
# --- semantics as HYPER_API_KEY: omitted → leave as-is; non-empty →
# --- update/append; explicitly empty → remove. Either explicit operation also
# --- deletes the obsolete numbered OPENCODE_API_KEY_<n> lines (and the marker
# --- comment the old apply script wrote above each): the server ignores them.
if [ "$OPENCODE_KEY_SET" -eq 1 ]; then
	if grep -q "^OPENCODE_API_KEY_[^=]*=" "$ENV_FILE"; then
		sed -i -e "/^OPENCODE_API_KEY_[^=]*=/d" -e "/^# Numbered OpenCode credential$/d" "$ENV_FILE"
		echo "  removed obsolete numbered OPENCODE_API_KEY_<n> line(s)" >&2
	fi
	if [ -n "$OPENCODE_KEY" ]; then
		if grep -q "^OPENCODE_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^OPENCODE_API_KEY=.*|OPENCODE_API_KEY=$OPENCODE_KEY|" "$ENV_FILE"
		else
			echo "OPENCODE_API_KEY=$OPENCODE_KEY" >> "$ENV_FILE"
		fi
		echo "  OPENCODE_API_KEY configured (value not echoed)" >&2
		# An OLDER dispatch-server (numbered-key era) refuses to boot when it
		# sees the unnumbered variable — make the ordering hazard visible.
		echo "  NOTE: OPENCODE_API_KEY needs a build with single-key OpenCode support; an older dispatch-server refuses to boot on it — run bin/build && bin/install before the service next restarts." >&2
	else
		sed -i "/^OPENCODE_API_KEY=/d" "$ENV_FILE"
		echo "  removed OPENCODE_API_KEY" >&2
	fi
elif grep -q "^OPENCODE_API_KEY_[^=]*=" "$ENV_FILE"; then
	echo "  note: obsolete numbered OPENCODE_API_KEY_<n> line(s) present — the server ignores them; set the single key with --opencode-key" >&2
fi

# If an OpenCode key is configured, make sure its base URL + default model are present.
if grep -q "^OPENCODE_API_KEY=." "$ENV_FILE"; then
	if ! grep -q "^DISPATCH_BASE_URL=" "$ENV_FILE"; then
		echo "DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1" >> "$ENV_FILE"
	fi
	if ! grep -q "^DISPATCH_MODEL=" "$ENV_FILE"; then
		echo "DISPATCH_MODEL=deepseek-v4.1-flash" >> "$ENV_FILE"
	fi
fi

# --- Delete the original single-key variable (obsolete — the server refuses to boot on it) ---
sed -i "/^DISPATCH_API_KEY=/d" "$ENV_FILE"
# Delete the backup key line
sed -i "/^DISPATCH_API_KEY_OPENCODE2=/d" "$ENV_FILE"

# --- Keep the configured service group readable for dev ---
chown root:"$REAL_GROUP" "$ENV_FILE"
chmod 640 "$ENV_FILE"

echo "Updated $ENV_FILE"
