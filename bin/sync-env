#!/bin/bash
# bin/sync-env — update /etc/dispatch/env with keys + system paths.
#
# Keys are NEVER stored in this file or in the repo. They are passed as
# arguments (or prompted interactively) and written directly to /etc/dispatch/env.
#
# Usage:
#   sudo bin/sync-env --umans-key "sk-..." --longcat-key "ak-..."
#   sudo bin/sync-env                          # prompts for keys interactively
#   sudo bin/sync-env --umans-key ""           # removes the umans key

set -euo pipefail

ENV_FILE="/etc/dispatch/env"
# PATH that includes user-installed tools (mise, bun, npm global, etc.)
DISPATCH_PATH="/home/PII_REDACTED_USER_01/.local/bin:/home/PII_REDACTED_USER_01/.local/share/mise/shims:/home/PII_REDACTED_USER_01/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

if [[ "$(id -u)" -ne 0 ]]; then
	echo "sync-env: must run as root (use sudo)" >&2
	exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
	echo "sync-env: $ENV_FILE not found — run 'sudo bin/setup-env' first" >&2
	exit 1
fi

# --- Parse arguments ---
UMANS_KEY=""
LONGCAT_KEY=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		--umans-key)
			UMANS_KEY="$2"
			shift 2
			;;
		--umans-key=*)
			UMANS_KEY="${1#--umans-key=}"
			shift
			;;
		--longcat-key)
			LONGCAT_KEY="$2"
			shift 2
			;;
		--longcat-key=*)
			LONGCAT_KEY="${1#--longcat-key=}"
			shift
			;;
		*)
			echo "sync-env: unknown argument: $1" >&2
			echo "Usage: sudo bin/sync-env [--umans-key \"sk-...\"] [--longcat-key \"ak-...\"]" >&2
			exit 1
			;;
	esac
done

# --- Prompt for keys if not provided via arguments ---
if [ -z "$UMANS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter UMANS_API_KEY (or press Enter to skip): " >&2
	read -r UMANS_KEY
fi
if [ -z "$LONGCAT_KEY" ] && [ -t 0 ]; then
	echo -n "Enter LONGCAT_API_KEY (or press Enter to skip): " >&2
	read -r LONGCAT_KEY
fi

# --- Update PATH ---
if grep -q "^PATH=" "$ENV_FILE"; then
	sed -i "s|^PATH=.*|PATH=$DISPATCH_PATH|" "$ENV_FILE"
else
	echo "PATH=$DISPATCH_PATH" >> "$ENV_FILE"
fi

# --- Update UMANS_API_KEY ---
if [ -n "$UMANS_KEY" ]; then
	if grep -q "^UMANS_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^UMANS_API_KEY=.*|UMANS_API_KEY=$UMANS_KEY|" "$ENV_FILE"
	else
		echo "UMANS_API_KEY=$UMANS_KEY" >> "$ENV_FILE"
	fi
	echo "  UMANS_API_KEY=${UMANS_KEY:0:8}..." >&2
fi

# --- Update LONGCAT_API_KEY ---
if [ -n "$LONGCAT_KEY" ]; then
	if grep -q "^LONGCAT_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^LONGCAT_API_KEY=.*|LONGCAT_API_KEY=$LONGCAT_KEY|" "$ENV_FILE"
	else
		echo "LONGCAT_API_KEY=$LONGCAT_KEY" >> "$ENV_FILE"
	fi
	echo "  LONGCAT_API_KEY=${LONGCAT_KEY:0:8}..." >&2
fi

# --- Delete the old OpenCode key (revoked — no longer used) ---
sed -i "/^DISPATCH_API_KEY=/d" "$ENV_FILE"
# Delete the backup key line
sed -i "/^DISPATCH_API_KEY_OPENCODE2=/d" "$ENV_FILE"

# --- Set permissions: root:PII_REDACTED_USER_01 640 (PII_REDACTED_USER_01 can read for dev) ---
chown root:PII_REDACTED_USER_01 "$ENV_FILE" 2>/dev/null || true
chmod 640 "$ENV_FILE"

echo "Updated $ENV_FILE"
