#!/bin/bash
# bin/sync-env — update /etc/dispatch/env with keys + system paths.
#
# Keys are NEVER stored in this file or in the repo. They are passed as
# arguments (or prompted interactively) and written directly to /etc/dispatch/env.
# Secret values are never echoed — not even their prefixes (only the provider /
# credential NUMBER is reported).
#
# Usage:
#   sudo bin/sync-env --umans-key "sk-..." --longcat-key "ak-..." --hyper-key "sk-hyper-..." --openrouter-key "sk-or-v1-..." --baseten-key "..." --coralbricks-key "cb_..." --opencode-key "1=sk-..."
#   sudo bin/sync-env                          # prompts for keys interactively
#   sudo bin/sync-env --umans-key ""           # removes the umans key (writes UMANS_API_KEY=)
#   sudo bin/sync-env --hyper-key ""           # removes the hyper key (disables the provider)
#   sudo bin/sync-env --openrouter-key ""      # removes the openrouter key (disables the provider)
#   sudo bin/sync-env --baseten-key ""         # removes the baseten key (disables the provider)
#   sudo bin/sync-env --coralbricks-key ""     # removes the coralbricks key (disables the provider)
#   sudo bin/sync-env --opencode-key "1="      # removes numbered OpenCode key #1
#
# Numbered OpenCode keys: `--opencode-key <number>=<key>`. An empty value
# removes that number. Numbers are stable identities; gaps are preserved. A
# repeated number is canonicalized last-wins. Values with newlines/CR/'='/pipe
# are rejected so they can never corrupt the env file or the sed edit.

set -euo pipefail

ENV_FILE="/etc/dispatch/env"
# PATH that includes user-installed tools (mise, bun, npm global, etc.)
DISPATCH_PATH="/home/PII_REDACTED_USER_01/.local/bin:/home/PII_REDACTED_USER_01/.local/share/mise/shims:/home/PII_REDACTED_USER_01/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

if [[ "$(id -u)" -ne 0 ]]; then
	echo "sync-env: must run as root (use sudo)" >&2
	exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
	echo "sync-env: $ENV_FILE not found — run 'sudo bin/setup-env' first" >&2
	exit 1
fi

# --- Parse arguments ---
UMANS_KEY=""
LONGCAT_KEY=""
HYPER_KEY=""
OPENROUTER_KEY=""
BASETEN_KEY=""
CORALBRICKS_KEY=""
# Whether --hyper-key was explicitly supplied on this run. Unlike umans/longcat
# (empty = skip), an explicitly empty --hyper-key means REMOVE the key.
HYPER_KEY_SET=0
# Whether --openrouter-key was explicitly supplied on this run. Same semantics
# as --hyper-key: explicitly empty means REMOVE the key.
OPENROUTER_KEY_SET=0
# Whether --baseten-key was explicitly supplied on this run. Same semantics
# as --hyper-key: explicitly empty means REMOVE the key.
BASETEN_KEY_SET=0
# Whether --coralbricks-key was explicitly supplied on this run. Same semantics
# as --baseten-key: explicitly empty means REMOVE the key.
CORALBRICKS_KEY_SET=0
# Maps a canonical OpenCode number → value. Empty value means "removal".
declare -A OPENCODE_MAP=()
add_opencode() {
	local pair="$1"
	local NUM VAL
	if [[ "$pair" != *=* ]]; then
		echo "sync-env: --opencode-key expects '<number>=<key>' (got '${pair}' with no '=' separator)" >&2
		exit 1
	fi
	NUM="${pair%%=*}"
	VAL="${pair#*=}"
	if [[ ! "$NUM" =~ ^[1-9][0-9]*$ ]]; then
		echo "sync-env: invalid OpenCode number '${NUM}' (must be a canonical positive integer [1-9][0-9]*, no leading zero)" >&2
		exit 1
	fi
	if [[ "$VAL" == *$'\n'* || "$VAL" == *$'\r'* || "$VAL" == *=* || "$VAL" == *'|'* ]]; then
		echo "sync-env: OpenCode key for number ${NUM} contains unsafe characters (newline/CR/'='/pipe) — refusing" >&2
		exit 1
	fi
	OPENCODE_MAP["$NUM"]="$VAL"
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--umans-key)
			UMANS_KEY="$2"
			shift 2
			;;
		--umans-key=*)
			UMANS_KEY="${1#--umans-key=}"
			shift
			;;
		--longcat-key)
			LONGCAT_KEY="$2"
			shift 2
			;;
		--longcat-key=*)
			LONGCAT_KEY="${1#--longcat-key=}"
			shift
			;;
		--hyper-key)
			HYPER_KEY="$2"
			HYPER_KEY_SET=1
			shift 2
			;;
		--hyper-key=*)
			HYPER_KEY="${1#--hyper-key=}"
			HYPER_KEY_SET=1
			shift
			;;
		--openrouter-key)
			OPENROUTER_KEY="$2"
			OPENROUTER_KEY_SET=1
			shift 2
			;;
		--openrouter-key=*)
			OPENROUTER_KEY="${1#--openrouter-key=}"
			OPENROUTER_KEY_SET=1
			shift
			;;
		--baseten-key)
			BASETEN_KEY="$2"
			BASETEN_KEY_SET=1
			shift 2
			;;
		--baseten-key=*)
			BASETEN_KEY="${1#--baseten-key=}"
			BASETEN_KEY_SET=1
			shift
			;;
		--coralbricks-key)
			CORALBRICKS_KEY="$2"
			CORALBRICKS_KEY_SET=1
			shift 2
			;;
		--coralbricks-key=*)
			CORALBRICKS_KEY="${1#--coralbricks-key=}"
			CORALBRICKS_KEY_SET=1
			shift
			;;
		--opencode-key)
			add_opencode "$2"
			shift 2
			;;
		--opencode-key=*)
			add_opencode "${1#--opencode-key=}"
			shift
			;;
		*)
			echo "sync-env: unknown argument: $1" >&2
			echo "Usage: sudo bin/sync-env [--umans-key \"sk-...\"] [--longcat-key \"ak-...\"] [--hyper-key \"sk-hyper-...\"] [--openrouter-key \"sk-or-v1-...\"] [--baseten-key \"...\"] [--coralbricks-key \"cb_...\"] [--opencode-key \"1=sk-...\"]" >&2
			exit 1
			;;
	esac
done

# --- Prompt for keys if not provided via arguments ---
if [ -z "$UMANS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter UMANS_API_KEY (or press Enter to skip): " >&2
	read -r UMANS_KEY
fi
if [ -z "$LONGCAT_KEY" ] && [ -t 0 ]; then
	echo -n "Enter LONGCAT_API_KEY (or press Enter to skip): " >&2
	read -r LONGCAT_KEY
fi
if [ -z "$HYPER_KEY" ] && [ -t 0 ]; then
	echo -n "Enter HYPER_API_KEY (or press Enter to skip): " >&2
	read -r HYPER_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--hyper-key ""` argument removes the key.
	if [ -n "$HYPER_KEY" ]; then
		HYPER_KEY_SET=1
	fi
fi
if [ -z "$OPENROUTER_KEY" ] && [ -t 0 ]; then
	echo -n "Enter OPENROUTER_API_KEY (or press Enter to skip): " >&2
	read -r OPENROUTER_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--openrouter-key ""` argument removes the key.
	if [ -n "$OPENROUTER_KEY" ]; then
		OPENROUTER_KEY_SET=1
	fi
fi
if [ -z "$BASETEN_KEY" ] && [ -t 0 ]; then
	echo -n "Enter BASETEN_API_KEY (or press Enter to skip): " >&2
	read -r BASETEN_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--baseten-key ""` argument removes the key.
	if [ -n "$BASETEN_KEY" ]; then
		BASETEN_KEY_SET=1
	fi
fi
if [ -z "$CORALBRICKS_KEY" ] && [ -t 0 ]; then
	echo -n "Enter CORAL_API_KEY (or press Enter to skip): " >&2
	read -r CORALBRICKS_KEY
	# An interactive empty value means "skip" (leave any existing key as-is) —
	# only an explicit `--coralbricks-key ""` argument removes the key.
	if [ -n "$CORALBRICKS_KEY" ]; then
		CORALBRICKS_KEY_SET=1
	fi
fi

# --- Update PATH ---
if grep -q "^PATH=" "$ENV_FILE"; then
	sed -i "s|^PATH=.*|PATH=$DISPATCH_PATH|" "$ENV_FILE"
else
	echo "PATH=$DISPATCH_PATH" >> "$ENV_FILE"
fi

# --- Update UMANS_API_KEY (empty value → write empty line to disable) ---
if [ -n "$UMANS_KEY" ]; then
	if grep -q "^UMANS_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^UMANS_API_KEY=.*|UMANS_API_KEY=$UMANS_KEY|" "$ENV_FILE"
	else
		echo "UMANS_API_KEY=$UMANS_KEY" >> "$ENV_FILE"
	fi
fi
if [ -n "$UMANS_KEY" ]; then
	echo "  UMANS_API_KEY ${UMANS_KEY:+configured} (value not echoed)" >&2
fi

# --- Update LONGCAT_API_KEY (empty value → write empty line to disable) ---
if [ -n "$LONGCAT_KEY" ]; then
	if grep -q "^LONGCAT_API_KEY=" "$ENV_FILE"; then
		sed -i "s|^LONGCAT_API_KEY=.*|LONGCAT_API_KEY=$LONGCAT_KEY|" "$ENV_FILE"
	else
		echo "LONGCAT_API_KEY=$LONGCAT_KEY" >> "$ENV_FILE"
	fi
fi
if [ -n "$LONGCAT_KEY" ]; then
	echo "  LONGCAT_API_KEY ${LONGCAT_KEY:+configured} (value not echoed)" >&2
fi

# --- Update HYPER_API_KEY. Distinguish "flag omitted" from "--hyper-key ''".
# --- Omitted → leave the key as-is. Non-empty value → update/append. Explicitly
# --- empty value → REMOVE the key (disables the provider).
if [ "$HYPER_KEY_SET" -eq 1 ]; then
	if [ -n "$HYPER_KEY" ]; then
		if grep -q "^HYPER_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^HYPER_API_KEY=.*|HYPER_API_KEY=$HYPER_KEY|" "$ENV_FILE"
		else
			echo "HYPER_API_KEY=$HYPER_KEY" >> "$ENV_FILE"
		fi
		echo "  HYPER_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^HYPER_API_KEY=/d" "$ENV_FILE"
		echo "  removed HYPER_API_KEY" >&2
	fi
fi

# --- Update OPENROUTER_API_KEY. Same semantics as HYPER_API_KEY: omitted →
# --- leave as-is; non-empty → update/append; explicitly empty → remove.
if [ "$OPENROUTER_KEY_SET" -eq 1 ]; then
	if [ -n "$OPENROUTER_KEY" ]; then
		if grep -q "^OPENROUTER_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^OPENROUTER_API_KEY=.*|OPENROUTER_API_KEY=$OPENROUTER_KEY|" "$ENV_FILE"
		else
			echo "OPENROUTER_API_KEY=$OPENROUTER_KEY" >> "$ENV_FILE"
		fi
		echo "  OPENROUTER_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^OPENROUTER_API_KEY=/d" "$ENV_FILE"
		echo "  removed OPENROUTER_API_KEY" >&2
	fi
fi

# --- Update BASETEN_API_KEY. Same semantics as HYPER_API_KEY: omitted →
# --- leave as-is; non-empty → update/append; explicitly empty → remove.
if [ "$BASETEN_KEY_SET" -eq 1 ]; then
	if [ -n "$BASETEN_KEY" ]; then
		if grep -q "^BASETEN_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^BASETEN_API_KEY=.*|BASETEN_API_KEY=$BASETEN_KEY|" "$ENV_FILE"
		else
			echo "BASETEN_API_KEY=$BASETEN_KEY" >> "$ENV_FILE"
		fi
		echo "  BASETEN_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^BASETEN_API_KEY=/d" "$ENV_FILE"
		echo "  removed BASETEN_API_KEY" >&2
	fi
fi

# --- Update CORAL_API_KEY. Same semantics as HYPER_API_KEY: omitted →
# --- leave as-is; non-empty → update/append; explicitly empty → remove.
if [ "$CORALBRICKS_KEY_SET" -eq 1 ]; then
	if [ -n "$CORALBRICKS_KEY" ]; then
		if grep -q "^CORAL_API_KEY=" "$ENV_FILE"; then
			sed -i "s|^CORAL_API_KEY=.*|CORAL_API_KEY=$CORALBRICKS_KEY|" "$ENV_FILE"
		else
			echo "CORAL_API_KEY=$CORALBRICKS_KEY" >> "$ENV_FILE"
		fi
		echo "  CORAL_API_KEY configured (value not echoed)" >&2
	else
		sed -i "/^CORAL_API_KEY=/d" "$ENV_FILE"
		echo "  removed CORAL_API_KEY" >&2
	fi
fi

# --- Update numbered OpenCode keys (OPENCODE_API_KEY_<n>). Last-wins +
# --- deterministic: iterate the map in numeric order. Empty value → remove.
for NUM in $(printf '%s\n' "${!OPENCODE_MAP[@]}" | sort -n); do
	VAL="${OPENCODE_MAP[$NUM]}"
	VAR="OPENCODE_API_KEY_${NUM}"
	if [ -n "$VAL" ]; then
		if grep -q "^$VAR=" "$ENV_FILE"; then
			sed -i "s|^$VAR=.*|$VAR=$VAL|" "$ENV_FILE"
		else
			echo "$VAR=$VAL" >> "$ENV_FILE"
		fi
		echo "  $VAR configured (value not echoed)" >&2
	else
		# Empty value → remove the numbered key.
		sed -i "/^$VAR=/d" "$ENV_FILE"
		echo "  removed $VAR" >&2
	fi
done

# If any numbered OpenCode keys remain, make sure the shared defaults are present.
if grep -q "^OPENCODE_API_KEY_" "$ENV_FILE"; then
	if ! grep -q "^DISPATCH_BASE_URL=" "$ENV_FILE"; then
		echo "DISPATCH_BASE_URL=https://opencode.ai/zen/go/v1" >> "$ENV_FILE"
	fi
	if ! grep -q "^DISPATCH_MODEL=" "$ENV_FILE"; then
		echo "DISPATCH_MODEL=deepseek-v4-flash" >> "$ENV_FILE"
	fi
fi

# --- Delete the old OpenCode key (obsolete — no longer supported) ---
sed -i "/^DISPATCH_API_KEY=/d" "$ENV_FILE"
# Delete the backup key line
sed -i "/^DISPATCH_API_KEY_OPENCODE2=/d" "$ENV_FILE"

# --- Set permissions: root:PII_REDACTED_USER_01 640 (PII_REDACTED_USER_01 can read for dev) ---
chown root:PII_REDACTED_USER_01 "$ENV_FILE" 2>/dev/null || true
chmod 640 "$ENV_FILE"

echo "Updated $ENV_FILE"