#!/usr/bin/env bash
# bin/up — run the Dispatch backend + web frontend together, both live-reloading.
# Also loads the external Claude + Codex (OpenAI) extensions when their repos
# are checked out as siblings of this backend's parent workspace root.
# Ctrl-C stops BOTH cleanly (including the backend's spawned observability collector).
#
#   backend  (this repo)        bun --watch  → HTTP :24203 + surface WS :24205  (FULL restart on change)
#            + DISPATCH_EXTERNAL_EXTENSIONS → loads ../claude's and ../codex's
#              extensions (when present), so `claude/<model>` and `openai/<model>`
#              appear in the catalog and bill via their respective OAuth subscriptions.
#   frontend (../frontend)   vite         → http://localhost:24204           (HMR, in-place)
#
# Assumes frontend is a sibling of this repo. Run:  bin/up   (or:  bun run dev:all)

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # .../backend/bin
BACKEND="$(cd "$HERE/.." && pwd)"                       # backend repo root
WORKSPACE="$(cd "$HERE/../.." && pwd)"                  # workspace root (parent of backend)
FRONTEND="$WORKSPACE/frontend"                          # sibling repo
CLAUDE="$WORKSPACE/claude"
CODEX="$WORKSPACE/codex"

if [ ! -d "$FRONTEND" ]; then
	echo "up: frontend repo not found at $FRONTEND" >&2
	echo "up: check out 'frontend' beside this repo and retry." >&2
	exit 1
fi

# --- external extension entries (optional — skip silently if repos absent) ---
EXTERNAL_EXTENSIONS=""
LOADED_LABELS=""
maybe_add_extension_pair() {
	# $1 = repo dir, $2 = auth pkg name, $3 = provider pkg name, $4 = label, $5 = node_modules scope
	local repo="$1" auth_pkg="$2" provider_pkg="$3" label="$4" scope="$5"
	if [ ! -d "$repo" ]; then
		return 0  # repo not checked out — skip silently
	fi
	local auth_file="$repo/packages/$auth_pkg/src/index.ts"
	local provider_file="$repo/packages/$provider_pkg/src/index.ts"
	for f in "$auth_file" "$provider_file"; do
		if [ ! -f "$f" ]; then
			echo "up: $label extension entry missing: $f" >&2
			exit 1
		fi
	done
	# Ensure workspace deps are linked (cheap no-op if already installed).
	if [ ! -d "$repo/node_modules/$scope" ]; then
		echo "[up] installing $label workspace deps (first run)…"
		( cd "$repo" && bun install ) || { echo "up: bun install failed in $repo" >&2; exit 1; }
	fi
	if [ -n "$EXTERNAL_EXTENSIONS" ]; then
		EXTERNAL_EXTENSIONS="$EXTERNAL_EXTENSIONS,"
	fi
	EXTERNAL_EXTENSIONS="$EXTERNAL_EXTENSIONS$auth_file,$provider_file"
	if [ -n "$LOADED_LABELS" ]; then
		LOADED_LABELS="$LOADED_LABELS + "
	fi
	LOADED_LABELS="$LOADED_LABELS$label"
}

maybe_add_extension_pair "$CLAUDE" "auth-claude" "provider-anthropic" "claude" "@dispatch-claude"
maybe_add_extension_pair "$CODEX" "auth-codex" "provider-openai" "codex" "@dispatch-codex"

export DISPATCH_EXTERNAL_EXTENSIONS="$EXTERNAL_EXTENSIONS"

cleanup() {
	echo
	echo "[up] stopping backend + frontend..."
	# Each child runs in its OWN process group (setsid) → signal the whole subtree.
	[ -n "${BACK_PG:-}" ]  && kill -TERM "-$BACK_PG"  2>/dev/null
	[ -n "${FRONT_PG:-}" ] && kill -TERM "-$FRONT_PG" 2>/dev/null
	sleep 1
	# Safety net for the backend's collector child + any straggler (bracket trick:
	# the literal pattern '[h]ost-bin' can't match the pkill command line itself).
	pkill -9 -f '[h]ost-bin/src/main'                2>/dev/null
	pkill -9 -f '[o]bservability-collector/src/main' 2>/dev/null
	[ -n "${BACK_PG:-}" ]  && kill -KILL "-$BACK_PG"  2>/dev/null
	[ -n "${FRONT_PG:-}" ] && kill -KILL "-$FRONT_PG" 2>/dev/null
	echo "[up] stopped."
	return 0
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# --- Source centralized keys/config (shared with prod) ---
# /etc/dispatch/env is the single source of truth for API keys and prod config.
# Dev overrides specific values below so the dev server uses local data paths
# and dev ports instead of prod ones.
# `set -a` (allexport) around the source so the keys are EXPORTED into the
# environment — otherwise `source` only creates non-exported shell variables
# that the `bun` child never inherits (so providers like longcat, whose key
# lives ONLY in /etc/dispatch/env, wouldn't register).
if [ -f /etc/dispatch/env ]; then
	set -a
	source /etc/dispatch/env
	set +a
else
	echo "up: /etc/dispatch/env not found — run 'sudo bin/setup-env' first" >&2
	exit 1
fi

# Override dev-specific values (prod uses the defaults from /etc/dispatch/env).
# Unset prod data paths so main.ts falls back to its local .dispatch-data/ defaults.
export BACKEND_PORT=24203
export SURFACE_WS_PORT=24205
unset DISPATCH_DB DISPATCH_TRACE_DB DISPATCH_JOURNAL DISPATCH_WEB_DIR

echo "[up] backend  → http://localhost:24203   (surface WS :24205)   [bun --watch — restarts on change]"
if [ -n "$EXTERNAL_EXTENSIONS" ]; then
	echo "[up] extensions → loaded ($LOADED_LABELS)"
else
	echo "[up] extensions → (none — claude/codex repos not found as siblings)"
fi
echo "[up] frontend → http://localhost:24204                          [vite HMR]"
echo "[up] Ctrl-C to stop both."
echo

# DISPATCH_EXTERNAL_EXTENSIONS is exported above, so the backend subshell inherits it.
setsid bash -c "cd '$BACKEND' && exec env BACKEND_PORT=24203 SURFACE_WS_PORT=24205 bun --watch packages/host-bin/src/main.ts" \
	> >(sed -u 's/^/[backend]  /') 2>&1 &
BACK_PG=$!

setsid bash -c "cd '$FRONTEND' && exec bun run dev" \
	> >(sed -u 's/^/[frontend] /') 2>&1 &
FRONT_PG=$!

wait
